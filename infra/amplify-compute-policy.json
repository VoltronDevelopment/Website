{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VoltronWebsiteDynamoAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:328833518871:table/VoltronWebsiteInquiries"
      ]
    },
    {
      "Sid": "VoltronWebsiteSesSend",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail"
      ],
      "Resource": "*"
    }
  ]
}
