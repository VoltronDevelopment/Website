{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VoltronWebsiteDynamoAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:328833518871:table/VoltronWebsiteInquiries",
        "arn:aws:dynamodb:ap-south-1:328833518871:table/VoltronWebsiteInquiries/index/*"
      ]
    },
    {
      "Sid": "VoltronWebsiteSesSend",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    }
  ]
}
