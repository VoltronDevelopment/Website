# AWS region for SES and DynamoDB. Mumbai is a sensible default for India hosting.
VOLTRON_AWS_REGION=ap-south-1

# DynamoDB table (partition key: id String, on-demand billing)
INQUIRIES_TABLE_NAME=VoltronWebsiteInquiries

# Email settings for inquiry notifications.
# SES_FROM_EMAIL must be a verified SES identity.
SES_FROM_EMAIL=info@voltroncoat.com
INQUIRY_TO_EMAIL=info@voltroncoat.com

# Public site URL for SEO metadata (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.voltronlattice.com

# Temporary founder preview access. Generate scrypt hashes; never store plaintext passwords here.
# Format: username:salt-hex:scrypt-hash-hex,username:salt-hex:scrypt-hash-hex
FOUNDER_CREDENTIALS=
# Random value of at least 32 bytes; separate from ADMIN_SESSION_SECRET.
FOUNDER_SESSION_SECRET=

# Optional same-origin metrics collector. Unset means browser events only, no transmission.
# Events contain name, numeric value, pathname (no query string) and viewport class.
NEXT_PUBLIC_PERFORMANCE_ENDPOINT=
