# AWS region for SES and DynamoDB. Mumbai is a sensible default for India hosting.
VOLTRON_AWS_REGION=ap-south-1

# DynamoDB tables (partition key: id String, on-demand billing)
INQUIRIES_TABLE_NAME=VoltronWebsiteInquiries
PROJECTS_TABLE_NAME=VoltronWebsiteProjects
REVIEWS_TABLE_NAME=VoltronWebsiteReviews

# Email settings for inquiry notifications.
# SES_FROM_EMAIL must be a verified SES identity.
SES_FROM_EMAIL=info@voltroncoat.com
INQUIRY_TO_EMAIL=info@voltroncoat.com

# Public site URL for SEO metadata (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://voltroncoat.com

# Admin — Founder Project Control (comma-separated user:scrypt-hash pairs)
# Staging/prod: set ADMIN_CREDENTIALS and ADMIN_SESSION_SECRET in the Amplify
# console (or Secrets Manager). Never commit live values.
#
# Previously committed founder passwords, ADMIN_PASS, ADMIN_HASH, and
# SESSION_SECRET (retired .amplify-release-secrets.json dump) are compromised.
# Generate new hashes and a new session secret; rotate Amplify env vars.
# Do not reuse old secrets.
#
# npm run admin:hash-password -- "your-strong-password"
# ADMIN_CREDENTIALS=founder:scrypt$...
ADMIN_CREDENTIALS=founder:your-strong-password
ADMIN_SESSION_SECRET=generate-a-new-long-random-string-at-least-32-chars
