# AWS region for SES and DynamoDB. Mumbai is a sensible default for India hosting.
VOLTRON_AWS_REGION=ap-south-1

# DynamoDB tables (partition key: id String, on-demand billing)
INQUIRIES_TABLE_NAME=VoltronWebsiteInquiries
PROJECTS_TABLE_NAME=VoltronWebsiteProjects
REVIEWS_TABLE_NAME=VoltronWebsiteReviews

# Email settings for inquiry notifications.
# SES_FROM_EMAIL must be a verified SES identity.
SES_FROM_EMAIL=info@voltroncoat.com
INQUIRY_TO_EMAIL=info@voltroncoat.com

# Public site URL for SEO metadata (Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=https://voltroncoat.com

# Admin — Founder Project Control
# Prefer hashed passwords: npm run admin:hash-password -- "your-password"
# Then: ADMIN_CREDENTIALS=omkar:scrypt$...$...
# Plaintext still works for migration: omkar:temp-password
# ADMIN_CREDENTIALS=omkar:replace-me
# Or shared password for admin/omkar:
# ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
