{
  "name": "voltron-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize-images": "node scripts/optimize-images.mjs",
    "admin:ensure-tables": "node scripts/ensure-dynamo-tables.mjs",
    "admin:hash-password": "node scripts/hash-admin-password.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1042.0",
    "@aws-sdk/client-sesv2": "^3.1042.0",
    "@aws-sdk/lib-dynamodb": "^3.1042.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "sharp": "^0.35.3",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "sharp": "0.35.3"
  }
}
