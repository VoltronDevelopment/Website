{
  "name": "voltron-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "secret-scan": "node scripts/secret-scan.mjs",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "optimize-images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1042.0",
    "@aws-sdk/client-sesv2": "^3.1042.0",
    "@aws-sdk/lib-dynamodb": "^3.1042.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "lucide-react": "^1.55.0",
    "next": "15.5.23",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "sharp": "^0.35.3",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18"
  }
}
